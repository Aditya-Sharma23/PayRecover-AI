# Copy to backend/.env for local runs. Never commit real keys.
# For a public deployment, set these in the platform's secret store instead
# (public mode refuses to start while backend/.env exists).

# AI: Gemini through Google's Generative Language API (key from aistudio.google.com).
TESTPILOT_GOOGLE_API_KEY=
TESTPILOT_AI_MODEL=gemini-3.8-flash
# Tried in order when the main model is busy (HTTP 429/5xx) or does not answer:
TESTPILOT_AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.7-flash
# TESTPILOT_AI_TIMEOUT_SECONDS=90
# Local inference instead of Google's API:
# TESTPILOT_AI_PROVIDER=ollama
# TESTPILOT_OLLAMA_URL=http://127.0.0.1:11434
# TESTPILOT_AI_MODEL=llama3.2

# PayPal Sandbox (developer.paypal.com > Apps & Credentials > Sandbox).
# Used only to read orders back from PayPal; the API base is fixed to the Sandbox.
TESTPILOT_PAYPAL_CLIENT_ID=
TESTPILOT_PAYPAL_CLIENT_SECRET=
# PayPal webhooks (needs a public address): the webhook's id from your app on developer.paypal.com.
# Events are verified with PayPal before use; without it, POST /api/paypal/webhook refuses events.
# TESTPILOT_PAYPAL_WEBHOOK_ID=
# The store PayRecover investigates (its order records, catalog and price probe).
# TESTPILOT_STORE_URL=http://127.0.0.1:8100
# The deliberately vulnerable demo store:
# TESTPILOT_VULN_STORE_URL=http://127.0.0.1:8200
# The Risky store (correct payments, insecure website):
# TESTPILOT_RISKY_STORE_URL=http://127.0.0.1:8300

# Alert email, sent through Brevo (brevo.com, free plan): an API key, and a sender address
# you verified in Brevo (Senders, domains & dedicated IPs). Each user sets their own address in the dashboard.
# TESTPILOT_BREVO_API_KEY=
# TESTPILOT_ALERT_SENDER=you@example.com

# Zapier: PayRecover posts leak and recovery events to this Catch Hook URL (https only).
# TESTPILOT_ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/<account>/<hook>/
# Signs the "Approve recovery" links in those events; at least 32 random characters.
# TESTPILOT_APPROVAL_SECRET=

# History retention
# TESTPILOT_RETENTION_DAYS=30
# TESTPILOT_MAX_RUNS_PER_OWNER=200

# Optional locally; all required for public deployment (see docs/deployment.md)
# TESTPILOT_AUTH_ENABLED=true
# TESTPILOT_API_TOKENS=alice:<at-least-32-characters>,bob:<at-least-32-characters>
# TESTPILOT_RATE_LIMITING=true
# TESTPILOT_AUDIT_LOGGING=true
# TESTPILOT_PUBLIC_DEPLOYMENT=true
# TESTPILOT_PUBLIC_URL=https://testpilot.example.org
