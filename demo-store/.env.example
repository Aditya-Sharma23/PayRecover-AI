# Copy to demo-store/.env for local runs. Never commit real keys.
# PayPal Sandbox REST app: developer.paypal.com > Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Controlled defects, off by default: trust_client_price, confirm_without_capture
# STORE_DEFECTS=
# Allows switching defects at runtime via POST /api/defects (header X-Store-Admin-Token).
# STORE_ADMIN_TOKEN=<at-least-32-random-characters>
